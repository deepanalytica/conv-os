{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/deepanalytica/conv-os/blob/feat/assurance-gates/docs/foundation/schemas/step-proposal.schema.json",
  "title": "Conv OS StepProposal v1",
  "description": "Plan data only; validation never grants credentials or authorizes external effects.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mission_id",
    "step_id",
    "revision",
    "requirement_ids",
    "dependencies",
    "capability",
    "risk",
    "deadline",
    "budget",
    "policy_digest",
    "idempotency_key",
    "human_approval_required"
  ],
  "properties": {
    "mission_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "step_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "requirement_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(FR|NFR)-[0-9]{2}$"
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      }
    },
    "capability": {
      "type": "string",
      "enum": [
        "repo.read",
        "docs.read",
        "local.check",
        "repo.write.branch",
        "docs.write",
        "github.pr.create",
        "meta.message.send",
        "meta.account.connect",
        "payments.capture",
        "advertising.spend",
        "production.deploy",
        "whatsapp.number.migrate",
        "secrets.export"
      ]
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "deadline": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calls",
        "cost_usd_max"
      ],
      "properties": {
        "calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "cost_usd_max": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "minimum": 0
            }
          ]
        }
      }
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "human_approval_required": {
      "type": "boolean"
    }
  }
}
