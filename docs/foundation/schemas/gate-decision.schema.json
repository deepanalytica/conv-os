{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Conv OS GateDecision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_version",
    "decision",
    "may_execute",
    "gates"
  ],
  "properties": {
    "policy_version": {
      "type": "string"
    },
    "decision": {
      "type": "string",
      "enum": [
        "ALLOW",
        "REVIEW",
        "DENY"
      ]
    },
    "may_execute": {
      "type": "boolean"
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "decision",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^G[0-6]$"
          },
          "decision": {
            "type": "string",
            "enum": [
              "ALLOW",
              "REVIEW",
              "DENY"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
